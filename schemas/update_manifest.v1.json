{
  "$id": "https://kristin.local/schemas/update_manifest.v1.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "archive": {
      "minLength": 1,
      "type": "string"
    },
    "archiveSha256": {
      "pattern": "^[a-f0-9]{64}$",
      "type": "string"
    },
    "channel": {
      "enum": [
        "stable",
        "candidate",
        "nightly"
      ]
    },
    "compatibleFrom": {
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "type": "array",
      "uniqueItems": true
    },
    "minimumRollbackVersion": {
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:\\+[0-9]+)?$",
      "type": "string"
    },
    "notes": {
      "type": "string"
    },
    "product": {
      "const": "Kristin Local Agent"
    },
    "releasedAt": {
      "format": "date-time",
      "type": "string"
    },
    "schemaVersion": {
      "const": "1.0.0"
    },
    "version": {
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:\\+[0-9]+)?$",
      "type": "string"
    }
  },
  "required": [
    "schemaVersion",
    "product",
    "version",
    "channel",
    "archive",
    "archiveSha256",
    "releasedAt",
    "minimumRollbackVersion",
    "compatibleFrom"
  ],
  "title": "Kristin Update Manifest v1",
  "type": "object"
}

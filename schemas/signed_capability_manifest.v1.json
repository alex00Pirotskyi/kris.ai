{
  "$id": "https://kristin.local/schemas/signed_capability_manifest.v1.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Kristin Signed Capability Manifest v1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {"const": "1.0.0"},
    "manifest": {"$ref": "capability_manifest.v1.json"},
    "signature": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "signerId": {"type": "string", "minLength": 1},
        "algorithm": {"const": "hmac-sha256"},
        "signedAt": {"type": "string", "format": "date-time"},
        "payloadSha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "signature": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
      },
      "required": ["signerId", "algorithm", "signedAt", "payloadSha256", "signature"]
    }
  },
  "required": ["schemaVersion", "manifest", "signature"]
}

{
  "$id": "https://kristin.local/schemas/skill_candidate.v1.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "candidateHash": {
      "pattern": "^[a-f0-9]{64}$",
      "type": "string"
    },
    "createdAt": {
      "format": "date-time",
      "type": "string"
    },
    "evidenceHashes": {
      "items": {
        "pattern": "^[a-f0-9]{64}$",
        "type": "string"
      },
      "minItems": 1,
      "type": "array",
      "uniqueItems": true
    },
    "id": {
      "minLength": 1,
      "type": "string"
    },
    "instructions": {
      "minLength": 1,
      "type": "string"
    },
    "projectId": {
      "minLength": 1,
      "type": "string"
    },
    "recommendedTools": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "minItems": 1,
      "type": "array",
      "uniqueItems": true
    },
    "schemaVersion": {
      "const": "1.0.0"
    },
    "sourceEpisodeId": {
      "minLength": 1,
      "type": "string"
    },
    "title": {
      "maxLength": 200,
      "minLength": 1,
      "type": "string"
    },
    "triggers": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "type": "array",
      "uniqueItems": true
    }
  },
  "required": [
    "schemaVersion",
    "id",
    "projectId",
    "sourceEpisodeId",
    "title",
    "instructions",
    "recommendedTools",
    "evidenceHashes",
    "candidateHash",
    "createdAt"
  ],
  "title": "Kristin Skill Candidate v1",
  "type": "object"
}

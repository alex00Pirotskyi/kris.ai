{
  "$id": "https://local.kristin/schemas/runtime_boundary_contract.v1.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "acceptedAt": {
      "format": "date",
      "type": "string"
    },
    "acceptedBy": {
      "minLength": 1,
      "type": "string"
    },
    "authority": {
      "type": "object"
    },
    "contractVersion": {
      "const": "1.0.0"
    },
    "invariants": {
      "items": {
        "type": "string"
      },
      "minItems": 8,
      "type": "array"
    },
    "ipc": {
      "type": "object"
    },
    "mandatoryPlatforms": {
      "items": false,
      "prefixItems": [
        {
          "const": "windows"
        },
        {
          "const": "macos"
        },
        {
          "const": "linux"
        }
      ],
      "type": "array"
    },
    "processes": {
      "type": "object"
    },
    "schemaVersion": {
      "const": "1.0.0"
    },
    "status": {
      "const": "accepted"
    },
    "storage": {
      "type": "object"
    },
    "supersessionPolicy": {
      "minLength": 20,
      "type": "string"
    },
    "taskId": {
      "const": "P1-001"
    }
  },
  "required": [
    "schemaVersion",
    "contractVersion",
    "taskId",
    "status",
    "acceptedAt",
    "acceptedBy",
    "mandatoryPlatforms",
    "authority",
    "processes",
    "ipc",
    "storage",
    "invariants",
    "supersessionPolicy"
  ],
  "title": "Kristin runtime boundary contract v1",
  "type": "object"
}

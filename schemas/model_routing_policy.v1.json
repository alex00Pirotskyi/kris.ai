{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kristin.local/schemas/model_routing_policy.v1.json",
  "title": "Kristin Model Routing Request v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["request", "policy", "candidates"],
  "properties": {
    "request": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role", "requiredContextTokens", "dataBoundary"],
      "properties": {
        "role": {"enum": ["router", "spec", "planner", "executor", "verifier", "summarizer", "research", "safety_reviewer"]},
        "requiredContextTokens": {"type": "integer", "minimum": 1},
        "dataBoundary": {"enum": ["local", "private_remote", "public_cloud"]},
        "complexity": {"type": "integer", "minimum": 1, "maximum": 10},
        "maxLatencyMs": {"type": "integer", "minimum": 1},
        "maxEstimatedCostUsd": {"type": "number", "minimum": 0}
      }
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["localOnly", "approvedProviders", "approvedModels", "fallbackApproved"],
      "properties": {
        "localOnly": {"type": "boolean"},
        "approvedProviders": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "approvedModels": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "fallbackApproved": {"type": "boolean"},
        "maximumDataBoundary": {"enum": ["local", "private_remote", "public_cloud"]}
      }
    },
    "candidates": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["provider", "model", "roles", "dataBoundary", "contextTokens", "healthy", "reliabilityScore"],
        "properties": {
          "provider": {"type": "string", "minLength": 1},
          "model": {"type": "string", "minLength": 1},
          "roles": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
          "dataBoundary": {"enum": ["local", "private_remote", "public_cloud"]},
          "contextTokens": {"type": "integer", "minimum": 1},
          "healthy": {"type": "boolean"},
          "reliabilityScore": {"type": "number", "minimum": 0, "maximum": 1},
          "estimatedLatencyMs": {"type": "integer", "minimum": 0},
          "estimatedCostUsd": {"type": "number", "minimum": 0},
          "circuit": {"enum": ["closed", "open", "half_open"]}
        }
      }
    }
  }
}

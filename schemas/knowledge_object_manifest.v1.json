{
  "$id": "https://kristin.local/schemas/knowledge_object_manifest.v1.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "createdAt": {
      "format": "date-time",
      "type": "string"
    },
    "labels": {
      "additionalProperties": {
        "type": "string"
      },
      "type": "object"
    },
    "mediaType": {
      "minLength": 1,
      "type": "string"
    },
    "relativePath": {
      "minLength": 1,
      "type": "string"
    },
    "schemaVersion": {
      "const": "1.0.0"
    },
    "sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "type": "string"
    },
    "sizeBytes": {
      "minimum": 0,
      "type": "integer"
    }
  },
  "required": [
    "schemaVersion",
    "sha256",
    "relativePath",
    "mediaType",
    "sizeBytes",
    "createdAt"
  ],
  "title": "Kristin Knowledge Object Manifest v1",
  "type": "object"
}

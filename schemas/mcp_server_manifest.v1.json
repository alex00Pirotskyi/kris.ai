{
  "$id": "https://kristin.local/schemas/mcp_server_manifest.v1.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Kristin MCP Server Manifest v1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": "1.0.0"
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "label": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "transport": {
      "type": "string",
      "enum": [
        "local_stdio",
        "remote_https"
      ]
    },
    "executable": {
      "type": [
        "string",
        "null"
      ]
    },
    "endpoint": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^https://|^$"
    },
    "sandboxRequired": {
      "type": "boolean"
    },
    "allowedRoots": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "tools": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "resources": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "prompts": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "provenance": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "packageSha256": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[a-f0-9]{64}$|^$"
    }
  },
  "required": [
    "schemaVersion",
    "id",
    "label",
    "transport",
    "executable",
    "endpoint",
    "sandboxRequired",
    "allowedRoots",
    "tools",
    "resources",
    "prompts",
    "provenance",
    "packageSha256"
  ]
}

{
  "$id": "https://kristin.local/schemas/capability_manifest.v1.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Kristin Capability Manifest v1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {"const": "1.0.0"},
    "kind": {"type": "string", "enum": ["plugin", "skill", "agent"]},
    "id": {"type": "string", "minLength": 1},
    "title": {"type": "string", "minLength": 1, "maxLength": 200},
    "version": {"type": "integer", "minimum": 1},
    "purpose": {"type": "string", "minLength": 1},
    "inputSchema": {"type": "string", "minLength": 1},
    "outputSchema": {"type": "string", "minLength": 1},
    "capabilities": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "dataBoundary": {"type": "string", "enum": ["local", "private_remote", "public_cloud"]},
    "modelRequirements": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "approvalPolicy": {"type": "string", "enum": ["none", "reviewed", "explicit", "enterprise"]},
    "evaluationResults": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "provenance": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "compatibility": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true}
  },
  "required": [
    "schemaVersion", "kind", "id", "title", "version", "purpose",
    "inputSchema", "outputSchema", "capabilities", "dataBoundary",
    "modelRequirements", "approvalPolicy", "evaluationResults",
    "provenance", "compatibility"
  ]
}

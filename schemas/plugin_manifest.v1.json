{
  "$id": "https://kristin.local/schemas/plugin_manifest.v1.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "capabilities": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "minItems": 1,
      "type": "array",
      "uniqueItems": true
    },
    "compatibility": {
      "additionalProperties": false,
      "properties": {
        "minimumKristinVersion": {
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "minimumKristinVersion"
      ],
      "type": "object"
    },
    "dataBoundary": {
      "enum": [
        "local_only",
        "project_metadata_only",
        "brokered_https"
      ]
    },
    "id": {
      "minLength": 1,
      "type": "string"
    },
    "kind": {
      "enum": [
        "mcp_server",
        "a2a_agent",
        "skill_plugin"
      ]
    },
    "name": {
      "maxLength": 200,
      "minLength": 1,
      "type": "string"
    },
    "schemaVersion": {
      "const": "1.0.0"
    },
    "version": {
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:\\+[0-9]+)?$",
      "type": "string"
    }
  },
  "required": [
    "schemaVersion",
    "id",
    "kind",
    "name",
    "version",
    "capabilities",
    "dataBoundary",
    "compatibility"
  ],
  "title": "Kristin Plugin Manifest v1",
  "type": "object"
}

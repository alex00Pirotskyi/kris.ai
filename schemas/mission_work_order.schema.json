{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kristin.local/schemas/mission_work_order.schema.json",
  "title": "Kris Mission Execution 1.5 Work Order",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion", "workOrderId", "mission", "roadmapTask", "parentProductPr",
    "priority", "type", "objective", "requestedRole", "allowedPaths",
    "baseCommit", "baseTree", "dependencyRequirements", "requiredTests",
    "maxChildWorkOrders", "status", "createdBy", "createdAt"
  ],
  "properties": {
    "schemaVersion": {"const": 1},
    "workOrderId": {"type": "string", "pattern": "^WO-[A-Z0-9][A-Z0-9._-]{4,95}$"},
    "mission": {"type": "string", "pattern": "^MISSION-[0-9]{3}$"},
    "roadmapTask": {"type": "string", "pattern": "^P[0-9]+-[0-9]+$"},
    "parentProductPr": {"type": "integer", "minimum": 1},
    "priority": {"type": "integer", "minimum": 0, "maximum": 100},
    "type": {"enum": ["PRODUCT_FEATURE", "PRODUCT_DEFECT_REPAIR", "PRODUCT_TEST", "CI_REPAIR", "INTEGRATION", "REVIEW", "SECURITY_REVIEW", "AUTHORITY_UPDATE", "BLOCKER_REMOVAL", "EVIDENCE_FINALIZATION", "RELEASE_FINALIZATION", "INCIDENT"]},
    "objective": {"type": "string", "minLength": 1},
    "requestedRole": {"enum": ["CAPTAIN", "BUILDER", "TESTER", "DEFECT_HUNTER", "CI_REPAIR", "REVIEWER", "SECURITY_REVIEWER", "INTEGRATOR", "AUTHORITY_OWNER", "AUDITOR", "RELEASE_FINALIZER", "INCIDENT_RESPONDER"]},
    "allowedPaths": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "baseCommit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "baseTree": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "dependencyRequirements": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["task", "level"],
        "properties": {
          "task": {"type": "string", "pattern": "^P[0-9]+-[0-9]+$"},
          "level": {"enum": ["IMPLEMENTATION", "INTEGRATION", "LANDING", "ACCEPTANCE", "CERTIFICATION", "RELEASE"]}
        }
      }
    },
    "requiredTests": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "maxChildWorkOrders": {"type": "integer", "minimum": 0, "maximum": 20},
    "status": {"enum": ["CREATED", "READY", "RESERVED", "IN_PROGRESS", "HELPER_READY", "INTEGRATING", "VALIDATING", "REVIEW", "LANDED", "BLOCKED", "SUPERSEDED", "CANCELLED"]},
    "createdBy": {"type": "string", "minLength": 1},
    "createdAt": {"type": "string", "format": "date-time"},
    "supersedes": {"type": ["string", "null"]},
    "supersededBy": {"type": ["string", "null"]}
  }
}

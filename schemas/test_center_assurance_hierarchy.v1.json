{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.kristin/schemas/test_center_assurance_hierarchy.v1.json",
  "title": "Kristin Test Center formal assurance hierarchy",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "hierarchyId",
    "roadmapTaskId",
    "levels",
    "testBindings",
    "pendingMigrationSource",
    "pendingMigrationBindings",
    "reportContract"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0.0"
    },
    "hierarchyId": {
      "const": "test-center.assurance-hierarchy-v1"
    },
    "roadmapTaskId": {
      "const": "P8-001"
    },
    "levels": {
      "type": "array",
      "minItems": 8,
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "levelId",
          "rank",
          "displayName",
          "proofKind",
          "executionScope",
          "requiredPredecessorLevels",
          "requiredEvidence",
          "supportClaimCeiling",
          "description"
        ],
        "properties": {
          "levelId": {
            "enum": [
              "architecture_lint",
              "unit",
              "component",
              "integration",
              "platform",
              "adversarial",
              "benchmark",
              "release"
            ]
          },
          "rank": {
            "type": "integer",
            "minimum": 10,
            "maximum": 80
          },
          "displayName": {
            "type": "string",
            "minLength": 1
          },
          "proofKind": {
            "enum": [
              "SOURCE_ONLY",
              "BEHAVIORAL",
              "PLATFORM",
              "BENCHMARK",
              "RELEASE"
            ]
          },
          "executionScope": {
            "enum": [
              "STATIC",
              "PROCESS_LOCAL",
              "COMPONENT_BOUNDARY",
              "MULTI_COMPONENT",
              "NATIVE_PLATFORM",
              "HOSTILE_INPUT",
              "MEASURED_WORKLOAD",
              "RELEASE_CANDIDATE"
            ]
          },
          "requiredPredecessorLevels": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "enum": [
                "architecture_lint",
                "unit",
                "component",
                "integration",
                "platform",
                "adversarial",
                "benchmark",
                "release"
              ]
            }
          },
          "requiredEvidence": {
            "type": "array",
            "minItems": 2,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "supportClaimCeiling": {
            "enum": [
              "NONE",
              "SOURCE_FOUNDATION",
              "BEHAVIOR_SUPPORTED",
              "PLATFORM_SUPPORTED",
              "RELEASE_SUPPORTED"
            ]
          },
          "description": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "testBindings": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "testId",
          "levelId",
          "rationale"
        ],
        "properties": {
          "testId": {
            "type": "string",
            "pattern": "^tc\\.[a-z0-9._-]+\\.[a-z0-9._-]+$"
          },
          "levelId": {
            "enum": [
              "architecture_lint",
              "unit",
              "component",
              "integration",
              "platform",
              "adversarial",
              "benchmark",
              "release"
            ]
          },
          "rationale": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "pendingMigrationSource": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "pullRequest",
        "commit",
        "tree",
        "reviewCommentId",
        "integrationState"
      ],
      "properties": {
        "pullRequest": {
          "const": 64
        },
        "commit": {
          "const": "89a15332019c73675a19cdacd7021fae2199d75e"
        },
        "tree": {
          "const": "2ea1f8a718a69dba0120a4f98acb78053d6cebfb"
        },
        "reviewCommentId": {
          "const": 5203350863
        },
        "integrationState": {
          "const": "FROZEN_EXTERNAL_CANDIDATE"
        }
      }
    },
    "pendingMigrationBindings": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "testId",
          "levelId",
          "sourceOnly",
          "owningPullRequest",
          "integrationPolicy",
          "rationale"
        ],
        "properties": {
          "testId": {
            "type": "string",
            "pattern": "^tc\\.[a-z0-9._-]+\\.[a-z0-9._-]+$"
          },
          "levelId": {
            "enum": [
              "architecture_lint",
              "unit",
              "component",
              "integration",
              "platform",
              "adversarial",
              "benchmark",
              "release"
            ]
          },
          "sourceOnly": {
            "type": "boolean"
          },
          "owningPullRequest": {
            "type": "integer",
            "minimum": 1
          },
          "integrationPolicy": {
            "const": "BLOCK_UNTIL_ACTIVE_BINDING"
          },
          "rationale": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "reportContract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "requiredFields",
        "executionReportSchema",
        "unknownLevelPolicy",
        "crossLevelPromotionPolicy",
        "unexecutedResultStates",
        "sourceOnlySupportPromotion"
      ],
      "properties": {
        "requiredFields": {
          "type": "array",
          "minItems": 11,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "executionReportSchema": {
          "const": "schemas/test_center_assurance_execution_report.v1.json"
        },
        "unknownLevelPolicy": {
          "const": "FAIL"
        },
        "crossLevelPromotionPolicy": {
          "const": "FORBIDDEN"
        },
        "unexecutedResultStates": {
          "type": "array",
          "minItems": 3,
          "uniqueItems": true,
          "items": {
            "enum": [
              "BLOCKED",
              "SKIPPED",
              "NOT_IMPLEMENTED"
            ]
          }
        },
        "sourceOnlySupportPromotion": {
          "const": "FORBIDDEN"
        }
      }
    }
  }
}

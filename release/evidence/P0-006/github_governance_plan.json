{
  "apiBase": "https://api.github.com",
  "apiVersion": "2026-03-10",
  "labels": [
    {
      "color": "B60205",
      "description": "A separate security review is required before merge.",
      "name": "security-review:required"
    },
    {
      "color": "0E8A16",
      "description": "The required independent security review passed.",
      "name": "security-review:passed"
    },
    {
      "color": "D93F0B",
      "description": "Security review found a merge-blocking issue.",
      "name": "security-review:blocked"
    },
    {
      "color": "B60205",
      "description": "Blocks release promotion.",
      "name": "release:blocker"
    },
    {
      "color": "8B0000",
      "description": "Critical product or security risk.",
      "name": "risk:critical"
    },
    {
      "color": "D93F0B",
      "description": "High product or security risk.",
      "name": "risk:high"
    },
    {
      "color": "5319E7",
      "description": "Phase P0 stabilization work.",
      "name": "roadmap:p0"
    },
    {
      "color": "1D76DB",
      "description": "AI-assisted change; requires documented solo-maintainer review and mandatory green CI.",
      "name": "ai-generated-change"
    }
  ],
  "milestone": "P0-006",
  "p0_003Commit": "53a7d661cda1f714bbe3ff83c8e06d99cb433a20",
  "repository": "alex00Pirotskyi/kris.ai",
  "repositorySettings": {
    "allow_auto_merge": true,
    "allow_merge_commit": false,
    "allow_rebase_merge": true,
    "allow_squash_merge": true,
    "delete_branch_on_merge": true
  },
  "ruleset": {
    "bypass_actors": [],
    "conditions": {
      "ref_name": {
        "exclude": [],
        "include": [
          "~DEFAULT_BRANCH"
        ]
      }
    },
    "enforcement": "active",
    "name": "Kristin main protection",
    "rules": [
      {
        "type": "deletion"
      },
      {
        "type": "non_fast_forward"
      },
      {
        "type": "required_linear_history"
      },
      {
        "parameters": {
          "allowed_merge_methods": [
            "squash",
            "rebase"
          ],
          "dismiss_stale_reviews_on_push": true,
          "require_code_owner_review": false,
          "require_last_push_approval": false,
          "required_approving_review_count": 0,
          "required_review_thread_resolution": true
        },
        "type": "pull_request"
      },
      {
        "parameters": {
          "do_not_enforce_on_create": false,
          "required_status_checks": [
            {
              "context": "validate-ubuntu"
            },
            {
              "context": "validate-windows"
            },
            {
              "context": "validate-macos"
            }
          ],
          "strict_required_status_checks_policy": true
        },
        "type": "required_status_checks"
      }
    ],
    "target": "branch"
  },
  "schemaVersion": "1.0.0",
  "tokenPersisted": false,
  "tokenSource": "environment:GITHUB_TOKEN"
}

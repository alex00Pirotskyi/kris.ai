  "testCases": [
    {
      "assuranceClass": "source_contract",
      "displayName": "Canonical Test Center contract check",
      "mandatory": true,
      "moduleId": "tm.test-center",
      "purpose": "Validate schema structure, stable identities, safe argv profiles, deterministic affected-test mappings, and state-domain separation without mutating the repository.",
      "roadmapTaskIds": [],
      "testId": "tc.test-center.contracts"
    },
    {
      "assuranceClass": "source_contract",
      "displayName": "Test Center semantic regression suite",
      "mandatory": true,
      "moduleId": "tm.test-center",
      "purpose": "Reject unsafe profiles, invalid result coercion, cross-commit evidence, incomplete certification, and invalid Testing Studio presentation records.",
      "roadmapTaskIds": [],
      "testId": "tc.test-center.semantic-regressions"
    },
    {
      "assuranceClass": "source_contract",
      "displayName": "P3 dependency evidence",
      "mandatory": true,
      "moduleId": "tm.p3-readiness",
      "purpose": "Validate exact P1-012 and P2-004 dependency decisions and blocker taxonomy.",
      "roadmapTaskIds": [
        "P3-001"
      ],
      "testId": "tc.p3.readiness.dependencies"
    },
    {
      "assuranceClass": "source_contract",
      "displayName": "Automation-host inventory",
      "mandatory": true,
      "moduleId": "tm.p3-readiness",
      "purpose": "Validate candidate inventory and evidence classifications without selecting an architecture.",
      "roadmapTaskIds": [
        "P3-001"
      ],
      "testId": "tc.p3.readiness.automation-host-inventory"
    },
    {
      "assuranceClass": "source_contract",
      "displayName": "Measurement contract",
      "mandatory": true,
      "moduleId": "tm.p3-readiness",
      "purpose": "Validate that missing measurements remain explicit and no values are fabricated.",
      "roadmapTaskIds": [
        "P3-001"
      ],
      "testId": "tc.p3.readiness.measurement-contract"
    },
    {
      "assuranceClass": "source_contract",
      "displayName": "Packaging readiness contract",
      "mandatory": true,
      "moduleId": "tm.p3-readiness",
      "purpose": "Validate the future runtime packaging, shutdown, provenance, and offline requirements.",
      "roadmapTaskIds": [
        "P3-001"
      ],
      "testId": "tc.p3.readiness.packaging-contract"
    },
    {
      "assuranceClass": "source_contract",
      "displayName": "Browser fixture specification",
      "mandatory": true,
      "moduleId": "tm.p3-readiness",
      "purpose": "Validate required deterministic fixture coverage and record structure.",
      "roadmapTaskIds": [
        "P3-001"
      ],
      "testId": "tc.p3.readiness.fixture-specification"
    },
    {
      "assuranceClass": "source_contract",
      "displayName": "Fixture determinism",
      "mandatory": true,
      "moduleId": "tm.p3-readiness",
      "purpose": "Recompute fixture checksums and reject unstable identities, routes, or bytes.",
      "roadmapTaskIds": [
        "P3-001"
      ],
      "testId": "tc.p3.readiness.fixture-determinism"
    },
    {
      "assuranceClass": "source_contract",
      "displayName": "Fixture external-network denial",
      "mandatory": true,
      "moduleId": "tm.p3-readiness",
      "purpose": "Reject external URLs, credentials, unbounded payloads, and non-loopback network policy.",
      "roadmapTaskIds": [
        "P3-001"
      ],
      "testId": "tc.p3.readiness.network-denial"
    },
    {
      "assuranceClass": "source_contract",
      "displayName": "Generated-state boundary",
      "mandatory": true,
      "moduleId": "tm.p3-readiness",
      "purpose": "Validate generated-state ownership and future P9-002 boundary without creating a competing policy.",
      "roadmapTaskIds": [
        "P3-001"
      ],
      "testId": "tc.p3.readiness.generated-state-boundary"
    },
    {
      "assuranceClass": "source_contract",
      "displayName": "P3 claim boundary",
      "mandatory": true,
      "moduleId": "tm.p3-readiness",
      "purpose": "Reject capability inflation and P3-002+ implementation in the readiness lane.",
      "roadmapTaskIds": [
        "P3-001"
      ],
      "testId": "tc.p3.readiness.claim-boundary"
    }
  ],
